# =============================================================
# TruHire — Variables de Entorno
# Copia este archivo a .env.local y llena los valores reales.
# NUNCA commitear .env.local al repo.
# =============================================================

# ---- Supabase ----
# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings → API → Project API keys → anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...

# Settings → API → Project API keys → service_role (secret — solo server-side)
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# ---- Anthropic ----
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Resend (emails) ----
# resend.com → API Keys
RESEND_API_KEY=re_...

# ---- App URLs ----
# URL de tu app (cambiar en producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAREERS_URL=http://localhost:3001

# ---- Modelo AI ----
AI_MODEL=claude-sonnet-4-6
